{
  "upstream": "https://github.com/eternity4719/HowToLiveBetter",
  "sections": {
    "01": {
      "sha": "e2605d3e2242bd6216c9255192b8a8957a08c55a",
      "path": "book/01-不要早死.md",
      "header": "586db4f42ac6",
      "footer": null,
      "entries": [
        {
          "n": 1,
          "title": "系安全带，前排后排都系",
          "hash": "60b429581692",
          "mode": "T"
        },
        {
          "n": 2,
          "title": "骑摩托车、电动自行车戴头盔并扣好",
          "hash": "b192a62f2fb1",
          "mode": "T"
        },
        {
          "n": 3,
          "title": "装烟雾报警器；冬天在室内烧煤、用燃气取暖的再装一氧化碳报警器",
          "hash": "9c2fa18bbf8e",
          "mode": "T"
        },
        {
          "n": 4,
          "title": "燃气软管和灶具到期就换，不自己改管道，燃气公司上门推销可以直接拒绝",
          "hash": "a66729926ee6",
          "mode": "L"
        },
        {
          "n": 5,
          "title": "不采、不买、不吃野生蘑菇，任何「土办法鉴别」都不成立",
          "hash": "66e210aefa10",
          "mode": "T"
        },
        {
          "n": 6,
          "title": "电动自行车不推进楼道、不进电梯、不在家里充电",
          "hash": "42ef3aac216f",
          "mode": "L"
        },
        {
          "n": 7,
          "title": "量血压，高了就吃药降到达标",
          "hash": "e4dda4545ca9",
          "mode": "T"
        },
        {
          "n": 8,
          "title": "35 岁以后只要超重，就去查一次空腹血糖，正常也每三年再查",
          "hash": "3a7b9f2ed374",
          "mode": "T"
        },
        {
          "n": 9,
          "title": "开车不超速、不酒驾，不看手机，困了就停车歇",
          "hash": "3d78ac8d7f3a",
          "mode": "L"
        },
        {
          "n": 10,
          "title": "坐车时给 4 岁以下儿童用安全座椅，不要抱在怀里",
          "hash": "e69847d6a156",
          "mode": "L"
        },
        {
          "n": 11,
          "title": "家里有小孩就给窗户和阳台装限位器，纱窗不算防护",
          "hash": "b701ba456d8f",
          "mode": "T"
        },
        {
          "n": 12,
          "title": "儿童近水不离视线，划船、野泳穿救生衣",
          "hash": "8cda401b513a",
          "mode": "T"
        },
        {
          "n": 13,
          "title": "60 岁以上练平衡和腿部力量，改造家里的浴室和楼梯",
          "hash": "788bf58f9400",
          "mode": "T"
        },
        {
          "n": 14,
          "title": "查乙肝两对半，结合接种记录判断要不要补疫苗",
          "hash": "1c5d05b6e4a7",
          "mode": "T"
        },
        {
          "n": 15,
          "title": "被铁钉、木刺扎到或者伤口沾了泥土，当天去处理，顺便问破伤风要不要打",
          "hash": "af78b50c4d33",
          "mode": "T"
        },
        {
          "n": 16,
          "title": "女性接种 HPV 疫苗，越早越好",
          "hash": "5953c6109276",
          "mode": "L"
        },
        {
          "n": 17,
          "title": "女性 40 岁起做乳腺癌筛查，每两年一次钼靶",
          "hash": "d650c35f1753",
          "mode": "L"
        },
        {
          "n": 18,
          "title": "30 岁以上女性做宫颈癌筛查，优先 HPV 检测",
          "hash": "42825e9f821f",
          "mode": "T"
        },
        {
          "n": 19,
          "title": "45 到 50 岁起做结直肠癌筛查，做查大便隐血的粪便免疫化学检测或者肠镜",
          "hash": "5b6d14f1ef14",
          "mode": "T"
        },
        {
          "n": 20,
          "title": "有心血管病的人和老年人每年打流感疫苗",
          "hash": "ea185cd1bc21",
          "mode": "T"
        },
        {
          "n": 21,
          "title": "50 岁以后打带状疱疹疫苗",
          "hash": "a6de1e22328b",
          "mode": "T"
        },
        {
          "n": 22,
          "title": "65 岁以上打肺炎球菌疫苗",
          "hash": "573ee2b9430b",
          "mode": "T"
        },
        {
          "n": 23,
          "title": "查幽门螺杆菌，阳性就根除",
          "hash": "518bdb0c0e00",
          "mode": "T"
        },
        {
          "n": 24,
          "title": "重度吸烟者每年做一次低剂量胸部 CT",
          "hash": "083c1b71f6ff",
          "mode": "T"
        },
        {
          "n": 25,
          "title": "抑郁或有自杀念头时打 12356，家里不囤安眠药和农药",
          "hash": "f7e526214ec6",
          "mode": "L"
        },
        {
          "n": 26,
          "title": "备齐灭火器、灭火毯、逃生呼吸面罩和急救包，每年检查一次",
          "hash": "188983f824a0",
          "mode": "L"
        },
        {
          "n": 27,
          "title": "尿里出现肉眼看得见的血，哪怕不疼、哪怕第二天就干净了，也要去查一次",
          "hash": "e8fb31db2fb3",
          "mode": "T"
        },
        {
          "n": 28,
          "title": "勃起功能出了问题，先去查心血管，别当成单纯的「那方面的事」",
          "hash": "aeee2777188a",
          "mode": "T"
        },
        {
          "n": 29,
          "title": "减重、戒烟、把血压血糖控住，勃起功能能跟着好转",
          "hash": "50004c7e93fe",
          "mode": "T"
        },
        {
          "n": 30,
          "title": "性行为全程用安全套，不和别人共用针具",
          "hash": "07f322732e7b",
          "mode": "T"
        },
        {
          "n": 31,
          "title": "有过高危行为就去查一次艾滋病，疾控中心免费、结果保密",
          "hash": "95448e69469e",
          "mode": "L"
        },
        {
          "n": 32,
          "title": "自杀念头一冒出来先告诉身边的一个人，把这几十分钟交出去",
          "hash": "18ece666b7e4",
          "mode": "T"
        },
        {
          "n": 33,
          "title": "别把「救回来」当成兜底：喝农药、吸煤气之后急诊能保住的是命，可能保不住肺和脑子",
          "hash": "8282cd8e0c5c",
          "mode": "T"
        },
        {
          "n": 34,
          "title": "别拿「躺几天就好」赌高处坠落：进了创伤 ICU 的人多数活下来，代价按年算",
          "hash": "41c28f0120d0",
          "mode": "T"
        },
        {
          "n": 35,
          "title": "别拿「少一个肾没什么」换钱：剩下那个要替两个干活，卖过肾的人事后 86% 说身体变差",
          "hash": "fc2dbd5cc3f7",
          "mode": "L"
        },
        {
          "n": 36,
          "title": "不捡、不拆、不卖来路不明的金属件，带三叶草警示标志的离远点",
          "hash": "38cdb5b4260e",
          "mode": "L"
        },
        {
          "n": 37,
          "title": "赌到借钱还赌、心情一直低落时，先打 12356，再把银行卡和支付密码交给家人管",
          "hash": "4f2e2f556408",
          "mode": "L"
        },
        {
          "n": 38,
          "title": "有高危性行为的男男性行为者，去艾滋病定点医院问暴露前预防药，按时吃能少感染约七成",
          "hash": "dd968232b41d",
          "mode": "L"
        },
        {
          "n": 39,
          "title": "65 岁以上的女性去做一次双能 X 线骨密度检查，绝经后有骨质疏松危险因素的不用等到 65 岁",
          "hash": "f92592c8211e",
          "mode": "T"
        },
        {
          "n": 40,
          "title": "查出骨质疏松，或者轻轻一摔就骨折过，就请医生开抗骨质疏松药并坚持用，别拿补钙代替",
          "hash": "2353de44e44a",
          "mode": "T"
        },
        {
          "n": 41,
          "title": "上野外冰面前先打孔量厚度，不到 15 厘米别上，河上的冰和冰钓洞边别去",
          "hash": "11166eb1db78",
          "mode": "T"
        },
        {
          "n": 42,
          "title": "装好护罩、戴上护目镜加面屏再用角磨机，双手握稳，别装木工锯片切木头",
          "hash": "003e171fc04c",
          "mode": "T"
        },
        {
          "n": 43,
          "title": "直接问身边情绪不对的人「你有没有想过自杀」，问了不会让他更想",
          "hash": "966f080d1619",
          "mode": "T"
        },
        {
          "n": 44,
          "title": "心慌、心跳乱就去做心电图，查出房颤请医生评估吃抗凝药防中风，别拿阿司匹林代替",
          "hash": "0fcee7acfb6e",
          "mode": "T"
        },
        {
          "n": 45,
          "title": "成年人查一次丙肝抗体，阳性就再查核酸，确诊了吃 8 到 12 周口服药，绝大多数能治好",
          "hash": "f1aeafd8230f",
          "mode": "L"
        },
        {
          "n": 46,
          "title": "下化粪池、窨井、污水池、菜窖地窖、发酵罐等有限空间前，先通风、检测合格、落实防护和监护，条件不够不进入。有人倒下别跟着下去，打 119 和 120",
          "hash": "ae89700157a3",
          "mode": "L"
        },
        {
          "n": 47,
          "title": "45 岁以上，住在胃癌食管癌高发地区、有家族史或幽门螺杆菌阳性的，去做胃镜筛查",
          "hash": "3fa6094b0f8b",
          "mode": "T"
        },
        {
          "n": 48,
          "title": "泡发的木耳、银耳当顿吃完别过夜，河粉、肠粉这类湿米粉买来当天吃，家里不自制酵米面",
          "hash": "32d15bbcb088",
          "mode": "T"
        }
      ],
      "file": "book/01-dung-chet-som.md"
    },
    "02": {
      "sha": "e2605d3e2242bd6216c9255192b8a8957a08c55a",
      "path": "book/02-不要慢慢死.md",
      "header": "3ec503339a25",
      "footer": null,
      "entries": [
        {
          "n": 1,
          "title": "戒烟，越早越好",
          "hash": "cfcfc8f3b54d",
          "mode": "T"
        },
        {
          "n": 2,
          "title": "别在家里和车里抽烟，也别让客人在家里抽",
          "hash": "a5f3d7afefc1",
          "mode": "T"
        },
        {
          "n": 3,
          "title": "戒烟别光靠忍，先去拿药：吃伐尼克兰的成功率能翻一倍多",
          "hash": "1f72fc05f304",
          "mode": "L"
        },
        {
          "n": 4,
          "title": "定一个戒烟日，到那天一次停掉，别先慢慢减",
          "hash": "5fb4012525cf",
          "mode": "T"
        },
        {
          "n": 5,
          "title": "去戒烟门诊，或者打 12320 问当地有没有戒烟服务",
          "hash": "403cff0cc2be",
          "mode": "T"
        },
        {
          "n": 6,
          "title": "已经戒不掉再考虑电子烟，本来不吸烟的人别碰",
          "hash": "d70942d2e724",
          "mode": "L"
        },
        {
          "n": 7,
          "title": "不喝含糖饮料，换成无糖的也不算解决",
          "hash": "dcc11745be7f",
          "mode": "T"
        },
        {
          "n": 8,
          "title": "不嚼槟榔",
          "hash": "6f935725609c",
          "mode": "T"
        },
        {
          "n": 9,
          "title": "把家里的食盐换成低钠盐（钾盐）",
          "hash": "d81f3adeb37b",
          "mode": "T"
        },
        {
          "n": 10,
          "title": "认真刷牙，每天清一次牙缝，缺了牙去看牙医",
          "hash": "13cc83a6edeb",
          "mode": "T"
        },
        {
          "n": 11,
          "title": "每天走到 7000–8000 步，或者每周累计快走 150–300 分钟",
          "hash": "b664620b45d7",
          "mode": "T"
        },
        {
          "n": 12,
          "title": "成年后定期查血脂，40 岁前每 2 到 5 年一次、40 岁起每年一次；有高血压、高血脂就按医嘱规律吃药，别自行停",
          "hash": "1a21a870926f",
          "mode": "T"
        },
        {
          "n": 13,
          "title": "每晚睡 7 小时左右，作息固定",
          "hash": "fd0284f8a4db",
          "mode": "T"
        },
        {
          "n": 14,
          "title": "常打网球、羽毛球、乒乓球这类球拍类运动",
          "hash": "ac2c5c233cb1",
          "mode": "T"
        },
        {
          "n": 15,
          "title": "把爬楼梯、快走赶路这类零碎的用力活动攒到每天四五分钟",
          "hash": "a91b8ced20f9",
          "mode": "T"
        },
        {
          "n": 16,
          "title": "每周做 30–60 分钟力量训练",
          "hash": "4d1a19f2c480",
          "mode": "T"
        },
        {
          "n": 17,
          "title": "别连着坐太久，隔一阵起身动一动",
          "hash": "e937c43c8c9f",
          "mode": "T"
        },
        {
          "n": 18,
          "title": "少吃加工肉（火腿、培根、香肠、午餐肉）",
          "hash": "75a7125731ca",
          "mode": "T"
        },
        {
          "n": 19,
          "title": "少喝或不喝酒",
          "hash": "ac91756ec394",
          "mode": "T"
        },
        {
          "n": 20,
          "title": "每天都喝酒、一停就手抖心慌的人，别自己硬戒",
          "hash": "1fdd6a64b0ff",
          "mode": "T"
        },
        {
          "n": 21,
          "title": "想少喝酒，先把一周喝了多少数出来，再找医生聊几分钟",
          "hash": "b14e88344887",
          "mode": "T"
        },
        {
          "n": 22,
          "title": "每天吃一小把坚果",
          "hash": "59a637bc9ac4",
          "mode": "T"
        },
        {
          "n": 23,
          "title": "把一部分红肉换成鱼和禽肉",
          "hash": "af9e7423e9da",
          "mode": "T"
        },
        {
          "n": 24,
          "title": "把一部分精米白面换成全谷物",
          "hash": "88bbb8fbc249",
          "mode": "T"
        },
        {
          "n": 25,
          "title": "每周喝三次以上茶",
          "hash": "f21f67c0aab4",
          "mode": "T"
        },
        {
          "n": 26,
          "title": "每天喝三到四杯咖啡，咖啡因总量不超过 400 mg，不加糖不加奶盖",
          "hash": "09336295ddcf",
          "mode": "T"
        },
        {
          "n": 27,
          "title": "每天吃够 5 份（约 400 g）水果蔬菜",
          "hash": "56e69d277901",
          "mode": "T"
        },
        {
          "n": 28,
          "title": "少吃超加工食品（薯片、方便面、糕点、速食）",
          "hash": "2d7d54e44e22",
          "mode": "T"
        },
        {
          "n": 29,
          "title": "做饭、取暖不烧煤和柴，换成电或燃气",
          "hash": "e4a87166bd22",
          "mode": "T"
        },
        {
          "n": 30,
          "title": "热的东西放一放再喝，不喝滚烫的茶、汤和咖啡",
          "hash": "ff1c0887e07d",
          "mode": "T"
        },
        {
          "n": 31,
          "title": "白天出门晒晒太阳，别整天不见光",
          "hash": "8dd2c8e0e427",
          "mode": "T"
        },
        {
          "n": 32,
          "title": "把 BMI 控制在 20–25，超重就减",
          "hash": "860d209ffef8",
          "mode": "T"
        },
        {
          "n": 33,
          "title": "每周吃四次以上辣椒",
          "hash": "1d1cc3082344",
          "mode": "T"
        },
        {
          "n": 34,
          "title": "每天喝一两份奶或酸奶",
          "hash": "2a298e0d3138",
          "mode": "T"
        },
        {
          "n": 35,
          "title": "鸡蛋不用戒，一天一个以内就行",
          "hash": "361b733cf447",
          "mode": "T"
        },
        {
          "n": 36,
          "title": "有条件就泡澡，别只冲淋浴",
          "hash": "71670f743c3d",
          "mode": "T"
        },
        {
          "n": 37,
          "title": "把午睡控制在半小时内，别超过一小时，非得睡一两小时才撑得住就去查原因",
          "hash": "da8ebbe7abd5",
          "mode": "T"
        },
        {
          "n": 38,
          "title": "熬夜之后第二天晚上就补觉，别攒到周末",
          "hash": "923d799096e6",
          "mode": "T"
        },
        {
          "n": 39,
          "title": "上夜班干得越久心血管风险越高，能转岗就趁早转",
          "hash": "aaf8f0bed788",
          "mode": "T"
        },
        {
          "n": 40,
          "title": "买预包装、有 SC 编号的食用油，不买小作坊散装自榨花生油",
          "hash": "4991bab9f886",
          "mode": "L"
        },
        {
          "n": 41,
          "title": "做饭用植物油代替猪油和黄油，不必为了健康换着买油，也别指望亚麻籽油护心",
          "hash": "bc42a4e08523",
          "mode": "T"
        },
        {
          "n": 42,
          "title": "炒菜、煎炸时打开抽油烟机，从开火一直开到做完",
          "hash": "30afa9d1a89b",
          "mode": "T"
        },
        {
          "n": 43,
          "title": "绝经前后潮热盗汗影响到生活，就去妇科评估激素治疗，别硬扛也别自己买药，更别拿它防心脏病",
          "hash": "1a5a9f9a6ad9",
          "mode": "T"
        },
        {
          "n": 44,
          "title": "本来就想养狗的，把每天遛狗算进走路量，别为了长寿专门去养狗",
          "hash": "706f31ab6286",
          "mode": "T"
        },
        {
          "n": 45,
          "title": "查出糖尿病前期（血糖偏高、还没到糖尿病），就靠少吃、减重、多动把糖尿病往后推，每半年复查一次血糖",
          "hash": "a4e935a7743d",
          "mode": "L"
        },
        {
          "n": 46,
          "title": "家里的花生、玉米、坚果和米面发了霉，整包扔掉，别挑掉霉的吃剩下的；嚼到发苦的坚果马上吐掉",
          "hash": "1446366f332d",
          "mode": "T"
        },
        {
          "n": 47,
          "title": "别吃淡水鱼虾做的鱼生、生鱼片、鱼生粥和醉虾，常吃过的去医院查一次肝吸虫，查出来按医嘱吃吡喹酮",
          "hash": "656baa193fd8",
          "mode": "T"
        }
      ],
      "file": "book/02-dung-chet-tu-tu.md"
    },
    "03": {
      "sha": "e2605d3e2242bd6216c9255192b8a8957a08c55a",
      "path": "book/03-不要浪费精力.md",
      "header": "01cea3f20bb2",
      "footer": null,
      "entries": [
        {
          "n": 1,
          "title": "关掉非必要通知，工作时把手机放到视线之外",
          "hash": "164385a4c727",
          "mode": "T"
        },
        {
          "n": 2,
          "title": "固定起床时间，周末也一样",
          "hash": "43dedd325479",
          "mode": "T"
        },
        {
          "n": 3,
          "title": "每晚睡够 7 到 8 小时，别把 6 小时当作够用",
          "hash": "dfdcfbe0d113",
          "mode": "T"
        },
        {
          "n": 4,
          "title": "下午两点以后不碰咖啡因",
          "hash": "cfad08624362",
          "mode": "T"
        },
        {
          "n": 5,
          "title": "把邮件和消息改成每天固定几次批量处理",
          "hash": "c43fe9a18a51",
          "mode": "T"
        },
        {
          "n": 6,
          "title": "做需要连续思考的工作时，把哪怕几秒钟的打断也挡在外面",
          "hash": "6669195b4f64",
          "mode": "T"
        },
        {
          "n": 7,
          "title": "一次只做一件事，不要边开会边回消息",
          "hash": "e65230e7405f",
          "mode": "T"
        },
        {
          "n": 8,
          "title": "睡前一小时不看发光屏幕，要看就看纸书或不开屏幕灯的墨水屏",
          "hash": "e1069e9dbe57",
          "mode": "T"
        },
        {
          "n": 9,
          "title": "到点就睡，不为游戏、短视频、色情内容熬夜",
          "hash": "403c0a4f372d",
          "mode": "T"
        },
        {
          "n": 10,
          "title": "深夜不做重大决定、不发要紧的消息",
          "hash": "0b292845f4af",
          "mode": "T"
        },
        {
          "n": 11,
          "title": "下午困了就睡 10 分钟，不要睡半小时",
          "hash": "7e3bbbd97eee",
          "mode": "T"
        },
        {
          "n": 12,
          "title": "在开放式办公室工作时用耳塞或找安静房间做需要记忆的活",
          "hash": "50b5b09c400d",
          "mode": "T"
        },
        {
          "n": 13,
          "title": "别把每周工作时间一味往上加：过了 49 小时上下，多干一小时多出的活越来越少",
          "hash": "84fb682eb6b5",
          "mode": "T"
        },
        {
          "n": 14,
          "title": "发现自己在反复回想同一件糟心事时，换个需要动手的活",
          "hash": "29417e993ae4",
          "mode": "T"
        },
        {
          "n": 15,
          "title": "把「事情肯定会更糟」这类念头当症状看，不当事实看",
          "hash": "5c90f1de37f2",
          "mode": "T"
        },
        {
          "n": 16,
          "title": "减少让你消耗的人际关系，学会拒绝不想接的请求",
          "hash": "ab8e29ebcb45",
          "mode": "T"
        },
        {
          "n": 17,
          "title": "生气时先离场，把对方当天气而不是当敌人",
          "hash": "b5a94be7e062",
          "mode": "T"
        },
        {
          "n": 18,
          "title": "情绪低落时先做性价比最高的几件事：动起来、多见光、按时睡、找人说、打 12356",
          "hash": "455823bc67b5",
          "mode": "L"
        },
        {
          "n": 19,
          "title": "把警察、医生、柜员当成按规则上班的人，别当成角色：能推动事情的是文书和期限，不是情绪",
          "hash": "f4bea64440a0",
          "mode": "L"
        },
        {
          "n": 20,
          "title": "别把「别人过得怎么样」当每日必读：给刷同龄人动态的应用设限或关掉",
          "hash": "08d82ed82b42",
          "mode": "T"
        },
        {
          "n": 21,
          "title": "觉得「所有人都看见我出丑了」的时候，把这个估计除以二",
          "hash": "321916aeccde",
          "mode": "T"
        },
        {
          "n": 22,
          "title": "把「别人要求我做到完美」当症状看，不当事实看",
          "hash": "23b998229f65",
          "mode": "T"
        },
        {
          "n": 23,
          "title": "生气时别靠打沙袋、跑一圈来发泄，先让身体慢下来",
          "hash": "8be04952d4f2",
          "mode": "T"
        },
        {
          "n": 24,
          "title": "心里压着一件事，可以连着几天把想法和感受写下来，但别指望它治病",
          "hash": "f4c89bed036c",
          "mode": "T"
        },
        {
          "n": 25,
          "title": "痛经就吃布洛芬这类止痛药，别硬扛；痛到耽误上班上学、吃三个月药也压不住，就去妇科查",
          "hash": "e156aa2f4660",
          "mode": "T"
        },
        {
          "n": 26,
          "title": "长期失眠（一周三晚以上、拖了三个月以上）先做失眠的认知行为治疗，别一上来就长期吃安眠药",
          "hash": "a4bd86d590f4",
          "mode": "T"
        },
        {
          "n": 27,
          "title": "打鼾很响、有人看见你睡着时憋气、白天困到开车都想睡的，去医院做睡眠监测查睡眠呼吸暂停，中重度的夜里戴呼吸机",
          "hash": "8331e4666da9",
          "mode": "T"
        }
      ],
      "file": "book/03-dung-lang-phi-suc-luc.md"
    },
    "08": {
      "sha": "e2605d3e2242bd6216c9255192b8a8957a08c55a",
      "path": "book/08-别把自己搭进去.md",
      "header": "cc4927e34dea",
      "footer": null,
      "entries": [
        {
          "n": 1,
          "title": "出了交通事故先停车、救人、报警，不要跑",
          "hash": "f9e44a25e216",
          "mode": "L"
        },
        {
          "n": 2,
          "title": "发现被骗，立刻打 110 或 96110 要求止付，别先自己查",
          "hash": "088bb547878f",
          "mode": "L"
        },
        {
          "n": 3,
          "title": "记住反诈硬规则：来电不轻信、信息不透露、链接不点击、转账多核实，七种最常见的骗局都是这个形状",
          "hash": "f99643345f92",
          "mode": "L"
        },
        {
          "n": 4,
          "title": "视频里看见脸、电话里听见声音都不算核实，涉及转账先挂断，用自己通讯录里的旧号码打回去",
          "hash": "d8b5d7ce2336",
          "mode": "L"
        },
        {
          "n": 5,
          "title": "被指控或被传唤，先请律师，不私了、不删记录",
          "hash": "2d1a1eaa7b72",
          "mode": "L"
        },
        {
          "n": 6,
          "title": "出了事主动去说清楚：自首最多能减四成刑，犯罪较轻的还能减更多甚至免罚，「躲过追诉期」这条路是堵死的",
          "hash": "e2124fa7279b",
          "mode": "L"
        },
        {
          "n": 7,
          "title": "喝了酒就不碰方向盘，包括电动车和「挪一下车」，也别把车借给喝了酒或没驾照的人开",
          "hash": "01515f278a5d",
          "mode": "L"
        },
        {
          "n": 8,
          "title": "不把银行卡、手机卡、支付账号借给任何人，「跑分」不是兼职",
          "hash": "fb09cf9ac152",
          "mode": "L"
        },
        {
          "n": 9,
          "title": "每年免费查两次自己的征信报告，看有没有不是自己办的贷款和卡",
          "hash": "ba37462794e5",
          "mode": "L"
        },
        {
          "n": 10,
          "title": "起了冲突先报警不动手，先动手的那个容易让对方的还手算成正当防卫",
          "hash": "a8290c3f3bf1",
          "mode": "L"
        },
        {
          "n": 11,
          "title": "躲不掉的侵害可以还手，但只打正在动手的那个人，他停你就停",
          "hash": "b7ac1befe790",
          "mode": "L"
        },
        {
          "n": 12,
          "title": "跟谁结了怨——被欠薪、被开除、被坑了钱——走投诉、仲裁、起诉，别去找人算账",
          "hash": "025b4e4e27f9",
          "mode": "L"
        },
        {
          "n": 13,
          "title": "再恨也别对不相干的人下手：驾车冲撞人群、在公共场所行凶按以危险方法危害公共安全定罪，起刑三年，死了人十年起步、最高死刑",
          "hash": "8a1d3b94c8a5",
          "mode": "L"
        },
        {
          "n": 14,
          "title": "冒出「拉个垫背的」「同归于尽」这种念头，当急症处理：离开现场，把车钥匙和刀交给别人，打 12356",
          "hash": "46a878e1e91d",
          "mode": "L"
        },
        {
          "n": 15,
          "title": "身边人说出「谁也别想好过」「带着孩子一起走」，别当气话：近亲属可以直接送诊，公安接到报警也必须管",
          "hash": "2893854d76dd",
          "mode": "L"
        },
        {
          "n": 16,
          "title": "网上不骂人、不造谣、不转发没核实的事；被网暴先留证再报警",
          "hash": "f648f56b7ed1",
          "mode": "L"
        },
        {
          "n": 17,
          "title": "签字前把纸看完，不替人签字，不在空白纸上签",
          "hash": "a0acdd79aaf7",
          "mode": "L"
        },
        {
          "n": 18,
          "title": "借钱写清借条，替人担保前先想清楚自己愿不愿意替他还",
          "hash": "3aff8a4865a5",
          "mode": "L"
        },
        {
          "n": 19,
          "title": "维权有期限：民事诉讼时效 3 年，劳动仲裁 1 年，过了对方一句「超过时效」就够",
          "hash": "6b50e486bfba",
          "mode": "L"
        },
        {
          "n": 20,
          "title": "被起诉、被执行了，如实报财产、能还多少还多少，别把房和钱转给亲友或公司",
          "hash": "c034b65fc6ef",
          "mode": "L"
        },
        {
          "n": 21,
          "title": "被限制消费或者被列入失信名单，先查清是按哪一条纳入的，能纠正的申请纠正",
          "hash": "9c6cb788f63c",
          "mode": "L"
        },
        {
          "n": 22,
          "title": "网购、二手交易被骗，先平台投诉，再报警，再算值不值得起诉",
          "hash": "2255b48c79a8",
          "mode": "L"
        },
        {
          "n": 23,
          "title": "恋爱和婚内的大额赠与，交付之前想清楚，交付之后原则上要不回",
          "hash": "ea8260b66295",
          "mode": "L"
        },
        {
          "n": 24,
          "title": "彩礼走转账并备注，聊天记录留好；借婚姻要钱可以要回",
          "hash": "88c327021ecb",
          "mode": "L"
        },
        {
          "n": 25,
          "title": "婚前财产不用怕，房子加名和父母出资先写清楚",
          "hash": "c815dd613160",
          "mode": "L"
        },
        {
          "n": 26,
          "title": "结婚前核对对方婚姻状况，以结婚为幌子骗钱的按诈骗罪追究",
          "hash": "463d50a2c179",
          "mode": "L"
        },
        {
          "n": 27,
          "title": "上门维修、验车、装修，先问价再动手，全程在旁边看着",
          "hash": "0ca042ac3f77",
          "mode": "L"
        },
        {
          "n": 28,
          "title": "别当「挂名法人」，别把身份证借给人注册公司",
          "hash": "cb85a3dc2c12",
          "mode": "L"
        },
        {
          "n": 29,
          "title": "出入境不帮陌生人带东西，不代收来路不明的包裹",
          "hash": "2fe010a08f41",
          "mode": "L"
        },
        {
          "n": 30,
          "title": "养狗必须牵绳：不牵绳出了事是无过错责任（你有没有错都要赔），赔到底。狗还要按时打狂犬病疫苗、办养犬登记",
          "hash": "36b358ba7d94",
          "mode": "L"
        },
        {
          "n": 31,
          "title": "对方喝到意识不清、睡着，或者可能不满 14 岁，就不要发生关系",
          "hash": "f890f691a13f",
          "mode": "L"
        },
        {
          "n": 32,
          "title": "发生关系、裸聊之后对方拿报警、发照片、告诉你单位来要钱，一分钱不给，一条记录不删，直接报警",
          "hash": "4a8784f93423",
          "mode": "L"
        },
        {
          "n": 33,
          "title": "被人捏造事实举报，可以要求追究：够治安处罚的拘留 5 日起，够罪的判 3 年以下",
          "hash": "0a7e34e8e1ec",
          "mode": "L"
        },
        {
          "n": 34,
          "title": "证据不足本来就应当判无罪，逼出来的口供应当排除；判了还有申诉和再审",
          "hash": "ecd878b5fbb3",
          "mode": "L"
        },
        {
          "n": 35,
          "title": "被羁押后撤案、不起诉或者判无罪的，去申请国家赔偿，按天算钱",
          "hash": "2d7c0e9d2d2a",
          "mode": "L"
        },
        {
          "n": 36,
          "title": "自己是受害人去索赔，走 12315、起诉或者律师，别单独赴对方的约，别把「给钱」和「我不曝光」绑成一句话",
          "hash": "bc6c91b60ec5",
          "mode": "L"
        },
        {
          "n": 37,
          "title": "被网暴了：先开防护、先固证，再在平台、禁令、报警三条路里挑",
          "hash": "6a017b434e4b",
          "mode": "L"
        },
        {
          "n": 38,
          "title": "「先给人买保险再动手」这条路法律上从头堵死：钱一分拿不到，罪按故意杀人加保险诈骗数罪并罚",
          "hash": "e29aa92d972b",
          "mode": "L"
        },
        {
          "n": 39,
          "title": "报警当场要受案回执，不立案要书面通知：7 日内可申请复议，再 7 日可申请复核，检察院能通知公安立案",
          "hash": "7112add8b71a",
          "mode": "L"
        },
        {
          "n": 40,
          "title": "别给办案、执法的人送钱送卡：行贿自己也判，对监察、执法、司法人员行贿还要从重",
          "hash": "61039b8f323d",
          "mode": "L"
        },
        {
          "n": 41,
          "title": "可能翻脸的电话和面谈，直接开录音：自己参加的谈话，不用先征得对方同意",
          "hash": "0a59e8a2f7a9",
          "mode": "L"
        },
        {
          "n": 42,
          "title": "现场出了事，先拍全景，再拍位置关系，最后拍损坏和伤情，原图原视频别删",
          "hash": "8c783d6de44a",
          "mode": "L"
        },
        {
          "n": 43,
          "title": "被家暴了：先报警留下出警记录，再去法院申请人身安全保护令，不用先离婚，也不收费",
          "hash": "94e3b809296d",
          "mode": "L"
        },
        {
          "n": 44,
          "title": "家里人赌博欠了债，别急着替他还：赌债法律不保护，为赌借的钱也不算夫妻共同债务",
          "hash": "8be78eaedf41",
          "mode": "L"
        },
        {
          "n": 45,
          "title": "熟人让你「帮忙刷个脸、做个见证」去办贷款，或者要你念验证码，别答应：这叫 AB 贷，借款人是你，不是担保人",
          "hash": "0ae8424138f3",
          "mode": "L"
        },
        {
          "n": 46,
          "title": "给门窗装好锁、门外装一盏感应灯，出门真的锁上：防入室盗窃靠这几样，单装一个报警器看不出用",
          "hash": "0d1b50d943c9",
          "mode": "L"
        }
      ],
      "file": "book/08-dung-tu-chuoc-hoa-vao-than-phap-luat.md"
    }
  }
}
