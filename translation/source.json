{
  "upstream": "https://github.com/eternity4719/HowToLiveBetter",
  "sections": {
    "01": {
      "sha": "e2605d3e2242bd6216c9255192b8a8957a08c55a",
      "path": "book/01-不要早死.md",
      "header": "586db4f42ac6",
      "footer": null,
      "entries": [
        {
          "n": 1,
          "title": "系安全带，前排后排都系",
          "hash": "60b429581692",
          "mode": "T"
        },
        {
          "n": 2,
          "title": "骑摩托车、电动自行车戴头盔并扣好",
          "hash": "b192a62f2fb1",
          "mode": "T"
        },
        {
          "n": 3,
          "title": "装烟雾报警器；冬天在室内烧煤、用燃气取暖的再装一氧化碳报警器",
          "hash": "9c2fa18bbf8e",
          "mode": "T"
        },
        {
          "n": 4,
          "title": "燃气软管和灶具到期就换，不自己改管道，燃气公司上门推销可以直接拒绝",
          "hash": "a66729926ee6",
          "mode": "L"
        },
        {
          "n": 5,
          "title": "不采、不买、不吃野生蘑菇，任何「土办法鉴别」都不成立",
          "hash": "66e210aefa10",
          "mode": "T"
        },
        {
          "n": 6,
          "title": "电动自行车不推进楼道、不进电梯、不在家里充电",
          "hash": "42ef3aac216f",
          "mode": "L"
        },
        {
          "n": 7,
          "title": "量血压，高了就吃药降到达标",
          "hash": "e4dda4545ca9",
          "mode": "T"
        },
        {
          "n": 8,
          "title": "35 岁以后只要超重，就去查一次空腹血糖，正常也每三年再查",
          "hash": "3a7b9f2ed374",
          "mode": "T"
        },
        {
          "n": 9,
          "title": "开车不超速、不酒驾，不看手机，困了就停车歇",
          "hash": "3d78ac8d7f3a",
          "mode": "L"
        },
        {
          "n": 10,
          "title": "坐车时给 4 岁以下儿童用安全座椅，不要抱在怀里",
          "hash": "e69847d6a156",
          "mode": "L"
        },
        {
          "n": 11,
          "title": "家里有小孩就给窗户和阳台装限位器，纱窗不算防护",
          "hash": "b701ba456d8f",
          "mode": "T"
        },
        {
          "n": 12,
          "title": "儿童近水不离视线，划船、野泳穿救生衣",
          "hash": "8cda401b513a",
          "mode": "T"
        },
        {
          "n": 13,
          "title": "60 岁以上练平衡和腿部力量，改造家里的浴室和楼梯",
          "hash": "788bf58f9400",
          "mode": "T"
        },
        {
          "n": 14,
          "title": "查乙肝两对半，结合接种记录判断要不要补疫苗",
          "hash": "1c5d05b6e4a7",
          "mode": "T"
        },
        {
          "n": 15,
          "title": "被铁钉、木刺扎到或者伤口沾了泥土，当天去处理，顺便问破伤风要不要打",
          "hash": "af78b50c4d33",
          "mode": "T"
        },
        {
          "n": 16,
          "title": "女性接种 HPV 疫苗，越早越好",
          "hash": "5953c6109276",
          "mode": "L"
        },
        {
          "n": 17,
          "title": "女性 40 岁起做乳腺癌筛查，每两年一次钼靶",
          "hash": "d650c35f1753",
          "mode": "L"
        },
        {
          "n": 18,
          "title": "30 岁以上女性做宫颈癌筛查，优先 HPV 检测",
          "hash": "42825e9f821f",
          "mode": "T"
        },
        {
          "n": 19,
          "title": "45 到 50 岁起做结直肠癌筛查，做查大便隐血的粪便免疫化学检测或者肠镜",
          "hash": "5b6d14f1ef14",
          "mode": "T"
        },
        {
          "n": 20,
          "title": "有心血管病的人和老年人每年打流感疫苗",
          "hash": "ea185cd1bc21",
          "mode": "T"
        },
        {
          "n": 21,
          "title": "50 岁以后打带状疱疹疫苗",
          "hash": "a6de1e22328b",
          "mode": "T"
        },
        {
          "n": 22,
          "title": "65 岁以上打肺炎球菌疫苗",
          "hash": "573ee2b9430b",
          "mode": "T"
        },
        {
          "n": 23,
          "title": "查幽门螺杆菌，阳性就根除",
          "hash": "518bdb0c0e00",
          "mode": "T"
        },
        {
          "n": 24,
          "title": "重度吸烟者每年做一次低剂量胸部 CT",
          "hash": "083c1b71f6ff",
          "mode": "T"
        },
        {
          "n": 25,
          "title": "抑郁或有自杀念头时打 12356，家里不囤安眠药和农药",
          "hash": "f7e526214ec6",
          "mode": "L"
        },
        {
          "n": 26,
          "title": "备齐灭火器、灭火毯、逃生呼吸面罩和急救包，每年检查一次",
          "hash": "188983f824a0",
          "mode": "L"
        },
        {
          "n": 27,
          "title": "尿里出现肉眼看得见的血，哪怕不疼、哪怕第二天就干净了，也要去查一次",
          "hash": "e8fb31db2fb3",
          "mode": "T"
        },
        {
          "n": 28,
          "title": "勃起功能出了问题，先去查心血管，别当成单纯的「那方面的事」",
          "hash": "aeee2777188a",
          "mode": "T"
        },
        {
          "n": 29,
          "title": "减重、戒烟、把血压血糖控住，勃起功能能跟着好转",
          "hash": "50004c7e93fe",
          "mode": "T"
        },
        {
          "n": 30,
          "title": "性行为全程用安全套，不和别人共用针具",
          "hash": "07f322732e7b",
          "mode": "T"
        },
        {
          "n": 31,
          "title": "有过高危行为就去查一次艾滋病，疾控中心免费、结果保密",
          "hash": "95448e69469e",
          "mode": "L"
        },
        {
          "n": 32,
          "title": "自杀念头一冒出来先告诉身边的一个人，把这几十分钟交出去",
          "hash": "18ece666b7e4",
          "mode": "T"
        },
        {
          "n": 33,
          "title": "别把「救回来」当成兜底：喝农药、吸煤气之后急诊能保住的是命，可能保不住肺和脑子",
          "hash": "8282cd8e0c5c",
          "mode": "T"
        },
        {
          "n": 34,
          "title": "别拿「躺几天就好」赌高处坠落：进了创伤 ICU 的人多数活下来，代价按年算",
          "hash": "41c28f0120d0",
          "mode": "T"
        },
        {
          "n": 35,
          "title": "别拿「少一个肾没什么」换钱：剩下那个要替两个干活，卖过肾的人事后 86% 说身体变差",
          "hash": "fc2dbd5cc3f7",
          "mode": "L"
        },
        {
          "n": 36,
          "title": "不捡、不拆、不卖来路不明的金属件，带三叶草警示标志的离远点",
          "hash": "38cdb5b4260e",
          "mode": "L"
        },
        {
          "n": 37,
          "title": "赌到借钱还赌、心情一直低落时，先打 12356，再把银行卡和支付密码交给家人管",
          "hash": "4f2e2f556408",
          "mode": "L"
        },
        {
          "n": 38,
          "title": "有高危性行为的男男性行为者，去艾滋病定点医院问暴露前预防药，按时吃能少感染约七成",
          "hash": "dd968232b41d",
          "mode": "L"
        },
        {
          "n": 39,
          "title": "65 岁以上的女性去做一次双能 X 线骨密度检查，绝经后有骨质疏松危险因素的不用等到 65 岁",
          "hash": "f92592c8211e",
          "mode": "T"
        },
        {
          "n": 40,
          "title": "查出骨质疏松，或者轻轻一摔就骨折过，就请医生开抗骨质疏松药并坚持用，别拿补钙代替",
          "hash": "2353de44e44a",
          "mode": "T"
        },
        {
          "n": 41,
          "title": "上野外冰面前先打孔量厚度，不到 15 厘米别上，河上的冰和冰钓洞边别去",
          "hash": "11166eb1db78",
          "mode": "T"
        },
        {
          "n": 42,
          "title": "装好护罩、戴上护目镜加面屏再用角磨机，双手握稳，别装木工锯片切木头",
          "hash": "003e171fc04c",
          "mode": "T"
        },
        {
          "n": 43,
          "title": "直接问身边情绪不对的人「你有没有想过自杀」，问了不会让他更想",
          "hash": "966f080d1619",
          "mode": "T"
        },
        {
          "n": 44,
          "title": "心慌、心跳乱就去做心电图，查出房颤请医生评估吃抗凝药防中风，别拿阿司匹林代替",
          "hash": "0fcee7acfb6e",
          "mode": "T"
        },
        {
          "n": 45,
          "title": "成年人查一次丙肝抗体，阳性就再查核酸，确诊了吃 8 到 12 周口服药，绝大多数能治好",
          "hash": "f1aeafd8230f",
          "mode": "L"
        },
        {
          "n": 46,
          "title": "下化粪池、窨井、污水池、菜窖地窖、发酵罐等有限空间前，先通风、检测合格、落实防护和监护，条件不够不进入。有人倒下别跟着下去，打 119 和 120",
          "hash": "ae89700157a3",
          "mode": "L"
        },
        {
          "n": 47,
          "title": "45 岁以上，住在胃癌食管癌高发地区、有家族史或幽门螺杆菌阳性的，去做胃镜筛查",
          "hash": "3fa6094b0f8b",
          "mode": "T"
        },
        {
          "n": 48,
          "title": "泡发的木耳、银耳当顿吃完别过夜，河粉、肠粉这类湿米粉买来当天吃，家里不自制酵米面",
          "hash": "32d15bbcb088",
          "mode": "T"
        }
      ],
      "file": "book/01-dung-chet-som.md"
    },
    "02": {
      "sha": "e2605d3e2242bd6216c9255192b8a8957a08c55a",
      "path": "book/02-不要慢慢死.md",
      "header": "3ec503339a25",
      "footer": null,
      "entries": [
        {
          "n": 1,
          "title": "戒烟，越早越好",
          "hash": "cfcfc8f3b54d",
          "mode": "T"
        },
        {
          "n": 2,
          "title": "别在家里和车里抽烟，也别让客人在家里抽",
          "hash": "a5f3d7afefc1",
          "mode": "T"
        },
        {
          "n": 3,
          "title": "戒烟别光靠忍，先去拿药：吃伐尼克兰的成功率能翻一倍多",
          "hash": "1f72fc05f304",
          "mode": "L"
        },
        {
          "n": 4,
          "title": "定一个戒烟日，到那天一次停掉，别先慢慢减",
          "hash": "5fb4012525cf",
          "mode": "T"
        },
        {
          "n": 5,
          "title": "去戒烟门诊，或者打 12320 问当地有没有戒烟服务",
          "hash": "403cff0cc2be",
          "mode": "T"
        },
        {
          "n": 6,
          "title": "已经戒不掉再考虑电子烟，本来不吸烟的人别碰",
          "hash": "d70942d2e724",
          "mode": "L"
        },
        {
          "n": 7,
          "title": "不喝含糖饮料，换成无糖的也不算解决",
          "hash": "dcc11745be7f",
          "mode": "T"
        },
        {
          "n": 8,
          "title": "不嚼槟榔",
          "hash": "6f935725609c",
          "mode": "T"
        },
        {
          "n": 9,
          "title": "把家里的食盐换成低钠盐（钾盐）",
          "hash": "d81f3adeb37b",
          "mode": "T"
        },
        {
          "n": 10,
          "title": "认真刷牙，每天清一次牙缝，缺了牙去看牙医",
          "hash": "13cc83a6edeb",
          "mode": "T"
        },
        {
          "n": 11,
          "title": "每天走到 7000–8000 步，或者每周累计快走 150–300 分钟",
          "hash": "b664620b45d7",
          "mode": "T"
        },
        {
          "n": 12,
          "title": "成年后定期查血脂，40 岁前每 2 到 5 年一次、40 岁起每年一次；有高血压、高血脂就按医嘱规律吃药，别自行停",
          "hash": "1a21a870926f",
          "mode": "T"
        },
        {
          "n": 13,
          "title": "每晚睡 7 小时左右，作息固定",
          "hash": "fd0284f8a4db",
          "mode": "T"
        },
        {
          "n": 14,
          "title": "常打网球、羽毛球、乒乓球这类球拍类运动",
          "hash": "ac2c5c233cb1",
          "mode": "T"
        },
        {
          "n": 15,
          "title": "把爬楼梯、快走赶路这类零碎的用力活动攒到每天四五分钟",
          "hash": "a91b8ced20f9",
          "mode": "T"
        },
        {
          "n": 16,
          "title": "每周做 30–60 分钟力量训练",
          "hash": "4d1a19f2c480",
          "mode": "T"
        },
        {
          "n": 17,
          "title": "别连着坐太久，隔一阵起身动一动",
          "hash": "e937c43c8c9f",
          "mode": "T"
        },
        {
          "n": 18,
          "title": "少吃加工肉（火腿、培根、香肠、午餐肉）",
          "hash": "75a7125731ca",
          "mode": "T"
        },
        {
          "n": 19,
          "title": "少喝或不喝酒",
          "hash": "ac91756ec394",
          "mode": "T"
        },
        {
          "n": 20,
          "title": "每天都喝酒、一停就手抖心慌的人，别自己硬戒",
          "hash": "1fdd6a64b0ff",
          "mode": "T"
        },
        {
          "n": 21,
          "title": "想少喝酒，先把一周喝了多少数出来，再找医生聊几分钟",
          "hash": "b14e88344887",
          "mode": "T"
        },
        {
          "n": 22,
          "title": "每天吃一小把坚果",
          "hash": "59a637bc9ac4",
          "mode": "T"
        },
        {
          "n": 23,
          "title": "把一部分红肉换成鱼和禽肉",
          "hash": "af9e7423e9da",
          "mode": "T"
        },
        {
          "n": 24,
          "title": "把一部分精米白面换成全谷物",
          "hash": "88bbb8fbc249",
          "mode": "T"
        },
        {
          "n": 25,
          "title": "每周喝三次以上茶",
          "hash": "f21f67c0aab4",
          "mode": "T"
        },
        {
          "n": 26,
          "title": "每天喝三到四杯咖啡，咖啡因总量不超过 400 mg，不加糖不加奶盖",
          "hash": "09336295ddcf",
          "mode": "T"
        },
        {
          "n": 27,
          "title": "每天吃够 5 份（约 400 g）水果蔬菜",
          "hash": "56e69d277901",
          "mode": "T"
        },
        {
          "n": 28,
          "title": "少吃超加工食品（薯片、方便面、糕点、速食）",
          "hash": "2d7d54e44e22",
          "mode": "T"
        },
        {
          "n": 29,
          "title": "做饭、取暖不烧煤和柴，换成电或燃气",
          "hash": "e4a87166bd22",
          "mode": "T"
        },
        {
          "n": 30,
          "title": "热的东西放一放再喝，不喝滚烫的茶、汤和咖啡",
          "hash": "ff1c0887e07d",
          "mode": "T"
        },
        {
          "n": 31,
          "title": "白天出门晒晒太阳，别整天不见光",
          "hash": "8dd2c8e0e427",
          "mode": "T"
        },
        {
          "n": 32,
          "title": "把 BMI 控制在 20–25，超重就减",
          "hash": "860d209ffef8",
          "mode": "T"
        },
        {
          "n": 33,
          "title": "每周吃四次以上辣椒",
          "hash": "1d1cc3082344",
          "mode": "T"
        },
        {
          "n": 34,
          "title": "每天喝一两份奶或酸奶",
          "hash": "2a298e0d3138",
          "mode": "T"
        },
        {
          "n": 35,
          "title": "鸡蛋不用戒，一天一个以内就行",
          "hash": "361b733cf447",
          "mode": "T"
        },
        {
          "n": 36,
          "title": "有条件就泡澡，别只冲淋浴",
          "hash": "71670f743c3d",
          "mode": "T"
        },
        {
          "n": 37,
          "title": "把午睡控制在半小时内，别超过一小时，非得睡一两小时才撑得住就去查原因",
          "hash": "da8ebbe7abd5",
          "mode": "T"
        },
        {
          "n": 38,
          "title": "熬夜之后第二天晚上就补觉，别攒到周末",
          "hash": "923d799096e6",
          "mode": "T"
        },
        {
          "n": 39,
          "title": "上夜班干得越久心血管风险越高，能转岗就趁早转",
          "hash": "aaf8f0bed788",
          "mode": "T"
        },
        {
          "n": 40,
          "title": "买预包装、有 SC 编号的食用油，不买小作坊散装自榨花生油",
          "hash": "4991bab9f886",
          "mode": "L"
        },
        {
          "n": 41,
          "title": "做饭用植物油代替猪油和黄油，不必为了健康换着买油，也别指望亚麻籽油护心",
          "hash": "bc42a4e08523",
          "mode": "T"
        },
        {
          "n": 42,
          "title": "炒菜、煎炸时打开抽油烟机，从开火一直开到做完",
          "hash": "30afa9d1a89b",
          "mode": "T"
        },
        {
          "n": 43,
          "title": "绝经前后潮热盗汗影响到生活，就去妇科评估激素治疗，别硬扛也别自己买药，更别拿它防心脏病",
          "hash": "1a5a9f9a6ad9",
          "mode": "T"
        },
        {
          "n": 44,
          "title": "本来就想养狗的，把每天遛狗算进走路量，别为了长寿专门去养狗",
          "hash": "706f31ab6286",
          "mode": "T"
        },
        {
          "n": 45,
          "title": "查出糖尿病前期（血糖偏高、还没到糖尿病），就靠少吃、减重、多动把糖尿病往后推，每半年复查一次血糖",
          "hash": "a4e935a7743d",
          "mode": "L"
        },
        {
          "n": 46,
          "title": "家里的花生、玉米、坚果和米面发了霉，整包扔掉，别挑掉霉的吃剩下的；嚼到发苦的坚果马上吐掉",
          "hash": "1446366f332d",
          "mode": "T"
        },
        {
          "n": 47,
          "title": "别吃淡水鱼虾做的鱼生、生鱼片、鱼生粥和醉虾，常吃过的去医院查一次肝吸虫，查出来按医嘱吃吡喹酮",
          "hash": "656baa193fd8",
          "mode": "T"
        }
      ],
      "file": "book/02-dung-chet-tu-tu.md"
    },
    "03": {
      "sha": "e2605d3e2242bd6216c9255192b8a8957a08c55a",
      "path": "book/03-不要浪费精力.md",
      "header": "01cea3f20bb2",
      "footer": null,
      "entries": [
        {
          "n": 1,
          "title": "关掉非必要通知，工作时把手机放到视线之外",
          "hash": "164385a4c727",
          "mode": "T"
        },
        {
          "n": 2,
          "title": "固定起床时间，周末也一样",
          "hash": "43dedd325479",
          "mode": "T"
        },
        {
          "n": 3,
          "title": "每晚睡够 7 到 8 小时，别把 6 小时当作够用",
          "hash": "dfdcfbe0d113",
          "mode": "T"
        },
        {
          "n": 4,
          "title": "下午两点以后不碰咖啡因",
          "hash": "cfad08624362",
          "mode": "T"
        },
        {
          "n": 5,
          "title": "把邮件和消息改成每天固定几次批量处理",
          "hash": "c43fe9a18a51",
          "mode": "T"
        },
        {
          "n": 6,
          "title": "做需要连续思考的工作时，把哪怕几秒钟的打断也挡在外面",
          "hash": "6669195b4f64",
          "mode": "T"
        },
        {
          "n": 7,
          "title": "一次只做一件事，不要边开会边回消息",
          "hash": "e65230e7405f",
          "mode": "T"
        },
        {
          "n": 8,
          "title": "睡前一小时不看发光屏幕，要看就看纸书或不开屏幕灯的墨水屏",
          "hash": "e1069e9dbe57",
          "mode": "T"
        },
        {
          "n": 9,
          "title": "到点就睡，不为游戏、短视频、色情内容熬夜",
          "hash": "403c0a4f372d",
          "mode": "T"
        },
        {
          "n": 10,
          "title": "深夜不做重大决定、不发要紧的消息",
          "hash": "0b292845f4af",
          "mode": "T"
        },
        {
          "n": 11,
          "title": "下午困了就睡 10 分钟，不要睡半小时",
          "hash": "7e3bbbd97eee",
          "mode": "T"
        },
        {
          "n": 12,
          "title": "在开放式办公室工作时用耳塞或找安静房间做需要记忆的活",
          "hash": "50b5b09c400d",
          "mode": "T"
        },
        {
          "n": 13,
          "title": "别把每周工作时间一味往上加：过了 49 小时上下，多干一小时多出的活越来越少",
          "hash": "84fb682eb6b5",
          "mode": "T"
        },
        {
          "n": 14,
          "title": "发现自己在反复回想同一件糟心事时，换个需要动手的活",
          "hash": "29417e993ae4",
          "mode": "T"
        },
        {
          "n": 15,
          "title": "把「事情肯定会更糟」这类念头当症状看，不当事实看",
          "hash": "5c90f1de37f2",
          "mode": "T"
        },
        {
          "n": 16,
          "title": "减少让你消耗的人际关系，学会拒绝不想接的请求",
          "hash": "ab8e29ebcb45",
          "mode": "T"
        },
        {
          "n": 17,
          "title": "生气时先离场，把对方当天气而不是当敌人",
          "hash": "b5a94be7e062",
          "mode": "T"
        },
        {
          "n": 18,
          "title": "情绪低落时先做性价比最高的几件事：动起来、多见光、按时睡、找人说、打 12356",
          "hash": "455823bc67b5",
          "mode": "L"
        },
        {
          "n": 19,
          "title": "把警察、医生、柜员当成按规则上班的人，别当成角色：能推动事情的是文书和期限，不是情绪",
          "hash": "f4bea64440a0",
          "mode": "L"
        },
        {
          "n": 20,
          "title": "别把「别人过得怎么样」当每日必读：给刷同龄人动态的应用设限或关掉",
          "hash": "08d82ed82b42",
          "mode": "T"
        },
        {
          "n": 21,
          "title": "觉得「所有人都看见我出丑了」的时候，把这个估计除以二",
          "hash": "321916aeccde",
          "mode": "T"
        },
        {
          "n": 22,
          "title": "把「别人要求我做到完美」当症状看，不当事实看",
          "hash": "23b998229f65",
          "mode": "T"
        },
        {
          "n": 23,
          "title": "生气时别靠打沙袋、跑一圈来发泄，先让身体慢下来",
          "hash": "8be04952d4f2",
          "mode": "T"
        },
        {
          "n": 24,
          "title": "心里压着一件事，可以连着几天把想法和感受写下来，但别指望它治病",
          "hash": "f4c89bed036c",
          "mode": "T"
        },
        {
          "n": 25,
          "title": "痛经就吃布洛芬这类止痛药，别硬扛；痛到耽误上班上学、吃三个月药也压不住，就去妇科查",
          "hash": "e156aa2f4660",
          "mode": "T"
        },
        {
          "n": 26,
          "title": "长期失眠（一周三晚以上、拖了三个月以上）先做失眠的认知行为治疗，别一上来就长期吃安眠药",
          "hash": "a4bd86d590f4",
          "mode": "T"
        },
        {
          "n": 27,
          "title": "打鼾很响、有人看见你睡着时憋气、白天困到开车都想睡的，去医院做睡眠监测查睡眠呼吸暂停，中重度的夜里戴呼吸机",
          "hash": "8331e4666da9",
          "mode": "T"
        }
      ],
      "file": "book/03-dung-lang-phi-suc-luc.md"
    },
    "04": {
      "sha": "e2605d3e2242bd6216c9255192b8a8957a08c55a",
      "path": "book/04-不要浪费时间.md",
      "header": "c92b3cebb13b",
      "footer": null,
      "entries": [
        {
          "n": 1,
          "title": "把「打算做」写成「几点、在哪、遇到什么就做什么」",
          "hash": "1f6421668c09",
          "mode": "T"
        },
        {
          "n": 2,
          "title": "开工前写下退出条件",
          "hash": "f34298db7270",
          "mode": "T"
        },
        {
          "n": 3,
          "title": "决定是否继续时，只看未来投入和未来回报，不看已投入多少",
          "hash": "9e01afdad11f",
          "mode": "T"
        },
        {
          "n": 4,
          "title": "估工期时按过去同类任务的实际耗时估，不按计划推",
          "hash": "e1faf8e69946",
          "mode": "T"
        },
        {
          "n": 5,
          "title": "会前发议程，没议程的会不开；能站着开就站着开",
          "hash": "83335c462575",
          "mode": "T"
        },
        {
          "n": 6,
          "title": "砍会议数量，能用文字异步解决的不开会",
          "hash": "0193170f482a",
          "mode": "T"
        },
        {
          "n": 7,
          "title": "把大任务拆成子任务再估时、再开工",
          "hash": "1dbcfb1fb054",
          "mode": "T"
        },
        {
          "n": 8,
          "title": "给没有外部截止的事自己定一个日期",
          "hash": "0bfeea4e5ea2",
          "mode": "T"
        },
        {
          "n": 9,
          "title": "把拖延当成在躲开难受，不要当成不够努力",
          "hash": "7ba75ecab284",
          "mode": "T"
        },
        {
          "n": 10,
          "title": "把要用的东西摆到手边，把不想碰的挪远，别指望当场忍住",
          "hash": "5c8f7f265503",
          "mode": "T"
        },
        {
          "n": 11,
          "title": "想让自己做到就把钱押上，但先问自己肯不肯押",
          "hash": "9b0051bb390c",
          "mode": "T"
        },
        {
          "n": 12,
          "title": "新习惯按月算，不要按「21 天」算",
          "hash": "ab394652ef93",
          "mode": "T"
        },
        {
          "n": 13,
          "title": "拖延已经影响生活的，用有随机试验支持的自助材料，不用非找治疗师",
          "hash": "fc9ad796e65f",
          "mode": "T"
        },
        {
          "n": 14,
          "title": "用自己的时薪决定哪些家务外包",
          "hash": "8d66d0890003",
          "mode": "T"
        },
        {
          "n": 15,
          "title": "给短视频和无目的刷屏设硬上限",
          "hash": "07e6c883fe14",
          "mode": "T"
        },
        {
          "n": 16,
          "title": "不看电视和滚动新闻，需要的信息定时集中看",
          "hash": "78e5707aea93",
          "mode": "T"
        },
        {
          "n": 17,
          "title": "花一次时间学常用软件的键盘快捷键和自动化",
          "hash": "71fb02592004",
          "mode": "T"
        },
        {
          "n": 18,
          "title": "选住处时把通勤时长放在前面，缩短单程通勤",
          "hash": "631b26960bf2",
          "mode": "T"
        }
      ],
      "file": "book/04-dung-lang-phi-thoi-gian.md"
    },
    "05": {
      "sha": "e2605d3e2242bd6216c9255192b8a8957a08c55a",
      "path": "book/05-不要浪费钱.md",
      "header": "249ed91f494d",
      "footer": null,
      "entries": [
        {
          "n": 1,
          "title": "关掉所有自动续费，改为到期手动续",
          "hash": "4234c9d7bdc2",
          "mode": "L"
        },
        {
          "n": 2,
          "title": "每年三月到六月做一次个税汇算，专项附加扣除该填的填",
          "hash": "e89f4cf89df4",
          "mode": "L"
        },
        {
          "n": 3,
          "title": "公积金不只用来买房：租房、装修、物业费都能提，2026 年 9 月 20 日起按新条例办",
          "hash": "7bf814115011",
          "mode": "S"
        },
        {
          "n": 4,
          "title": "每年重算一次手机和宽带套餐，用不上的降档，运营商不给转就投诉",
          "hash": "c82b8a3ffaf7",
          "mode": "L"
        },
        {
          "n": 5,
          "title": "不买彩票",
          "hash": "337cb31aa0da",
          "mode": "L"
        },
        {
          "n": 6,
          "title": "看到「高收益」「保本」「稳赚」直接走开",
          "hash": "56e3bd4a2b77",
          "mode": "L"
        },
        {
          "n": 7,
          "title": "不用信用卡最低还款，不为消费开分期或消费贷；非借不可，先把利息换成年化利率再比",
          "hash": "b26476eddc1a",
          "mode": "L"
        },
        {
          "n": 8,
          "title": "不给主播打赏、不给游戏充值、不冲动下单",
          "hash": "c28939050193",
          "mode": "L"
        },
        {
          "n": 9,
          "title": "孩子用手机充值打赏，八岁以上的大额支出未经家长追认可以主张退",
          "hash": "de34562bd293",
          "mode": "L"
        },
        {
          "n": 10,
          "title": "教孩子记一句话：网上任何人让你拿家长的手机去操作、去报验证码，都是骗子",
          "hash": "f0f2096550f0",
          "mode": "L"
        },
        {
          "n": 11,
          "title": "拒绝电子产品的延长保修（延保）",
          "hash": "62bae70a7280",
          "mode": "L"
        },
        {
          "n": 12,
          "title": "优先选通过一致性评价的仿制药和集采中选药",
          "hash": "a98ed6c7f753",
          "mode": "L"
        },
        {
          "n": 13,
          "title": "在医保 App 上办一次家庭共济绑定，职工医保个人账户的钱就能给配偶、父母、子女看病买药",
          "hash": "19e92d91ae6e",
          "mode": "S"
        },
        {
          "n": 14,
          "title": "喝烧开的自来水，不常年订饮水机用的桶装水、买瓶装水",
          "hash": "fcec44ff6d44",
          "mode": "L"
        },
        {
          "n": 15,
          "title": "不频繁交易股票，行情暴涨暴跌的时候更要少动手",
          "hash": "20ba360d5f7a",
          "mode": "T"
        },
        {
          "n": 16,
          "title": "不借钱投资、不加杠杆、不买自己看不懂的",
          "hash": "ba78cf678abe",
          "mode": "L"
        },
        {
          "n": 17,
          "title": "用宽基指数基金替代主动管理基金作为长期底仓（长期拿着不动的那部分钱）",
          "hash": "0fbe7d60d7e6",
          "mode": "T"
        },
        {
          "n": 18,
          "title": "同类基金优先选费率低的",
          "hash": "fb3c8d447de5",
          "mode": "T"
        },
        {
          "n": 19,
          "title": "别把钱押在一只股票、一个平台、一套房上",
          "hash": "af01e3fa2259",
          "mode": "T"
        },
        {
          "n": 20,
          "title": "开个人养老金账户前先算节税、查领取条件；不交个税或税率只有 3% 的人，别只为抵税交钱",
          "hash": "90d3200c3d8a",
          "mode": "L"
        },
        {
          "n": 21,
          "title": "健身房按次付费或短周期付费，除非有一年以上的稳定记录",
          "hash": "3223bd2e2a39",
          "mode": "T"
        },
        {
          "n": 22,
          "title": "交预付款要签书面合同；商家出风险要停收，跑路前你有权要回未消费的余额",
          "hash": "214c59248cf9",
          "mode": "L"
        },
        {
          "n": 23,
          "title": "大额非必需购买设 24 小时冷静期，网购善用七日无理由退货",
          "hash": "eb868440f67d",
          "mode": "L"
        },
        {
          "n": 24,
          "title": "不为「划线价」和大促囤货",
          "hash": "177d764cae1e",
          "mode": "L"
        },
        {
          "n": 25,
          "title": "保险优先买消费型，把「返还」「分红」当作不保证的部分",
          "hash": "bc35b79801ab",
          "mode": "L"
        },
        {
          "n": 26,
          "title": "三者险买够：交强险限额全国统一且不高，超出的部分从你自己家里出",
          "hash": "74ff580a4ef8",
          "mode": "L"
        },
        {
          "n": 27,
          "title": "先存出 3 到 6 个月生活费的应急金，放在随时能取的地方",
          "hash": "655756f71dfe",
          "mode": "L"
        },
        {
          "n": 28,
          "title": "提前还房贷之前先做一道比较题，不要凭感觉",
          "hash": "60b7332223a4",
          "mode": "L"
        },
        {
          "n": 29,
          "title": "网购认平台规则和法条，不认主播和「好评」",
          "hash": "c62b336986af",
          "mode": "L"
        },
        {
          "n": 30,
          "title": "直播间买的东西出了问题，先向平台要卖家和带货人的信息，平台必须给",
          "hash": "49ca3d8a7b96",
          "mode": "L"
        },
        {
          "n": 31,
          "title": "买到不安全的食品，除了退钱还能要十倍价款，增加赔偿不足一千元的按一千元算",
          "hash": "fc747ecd2578",
          "mode": "L"
        },
        {
          "n": 32,
          "title": "买大件前先查国家抽检通报、3C 认证和能效标识",
          "hash": "1696c39a6eff",
          "mode": "L"
        },
        {
          "n": 33,
          "title": "手串、玉石、名表、潮玩按「花掉的钱」算账，不按「存下的钱」算",
          "hash": "59d44cd1954b",
          "mode": "L"
        },
        {
          "n": 34,
          "title": "珠宝玉石只认带 CMA 标志的检测报告，并到发证部门官网核一下这家机构",
          "hash": "fabf546bd0d4",
          "mode": "L"
        },
        {
          "n": 35,
          "title": "盲盒、抽卡这类随机销售，按「这笔钱不会回来」算",
          "hash": "e9e6df82e07d",
          "mode": "L"
        },
        {
          "n": 36,
          "title": "在意食品里加了什么，就买预包装的：散装柜台法律上不要求标配料表",
          "hash": "6bde1d93c443",
          "mode": "L"
        },
        {
          "n": 37,
          "title": "亏了的股票也要按事先定好的规则卖掉，不靠往下补仓摊平成本翻身",
          "hash": "7794035a4fb7",
          "mode": "T"
        },
        {
          "n": 38,
          "title": "想买美股这类海外资产，走 QDII 基金或港股通，别去境外券商开户，也别拿每年的换汇额度去买",
          "hash": "b9383f5ccc32",
          "mode": "L"
        },
        {
          "n": 39,
          "title": "只给自己扛不住的损失买保险，扛得住的损失用应急金兜着",
          "hash": "aef8c1d3d0e4",
          "mode": "L"
        },
        {
          "n": 40,
          "title": "家里有人靠你的收入过日子，先给挣钱的人买定期寿险，别先给孩子买",
          "hash": "c3baa63eae1d",
          "mode": "L"
        },
        {
          "n": 41,
          "title": "签了一年以上的人身险又后悔，在犹豫期内退掉，保费基本全退",
          "hash": "b85317e12d71",
          "mode": "L"
        },
        {
          "n": 42,
          "title": "在银行柜台签字前，先看清手里的是存款还是保险",
          "hash": "6de5892992fa",
          "mode": "L"
        },
        {
          "n": 43,
          "title": "想退保就自己找保险公司办，别找「代理退保」，觉得被误导了打 12378 投诉",
          "hash": "bfc490a1bfaf",
          "mode": "L"
        },
        {
          "n": 44,
          "title": "保单上把受益人写成具体的人，出了事记得去领钱：寿险 5 年、其他保险 2 年内要主张",
          "hash": "0587fa454666",
          "mode": "L"
        },
        {
          "n": 45,
          "title": "别拿钱买比特币、泰达币这类虚拟货币，别人拉你一起投也不跟：交易不受法律保护，亏了打官司也要不回来",
          "hash": "ce8e686ed1ff",
          "mode": "L"
        },
        {
          "n": 46,
          "title": "没单位的人自己交职工养老保险，按最低档交、先把年限交够最划算；别当成一交就赚，按最低档也要领约 10 年才回本",
          "hash": "f0a93fe30031",
          "mode": "L"
        },
        {
          "n": 47,
          "title": "买新车提车时当场验车，收好发票和三包凭证；头 7 天、头 60 天里出大毛病，可以要求换车或退车",
          "hash": "6d8773c98b33",
          "mode": "L"
        },
        {
          "n": 48,
          "title": "在车商那里买二手车，先查出险和维修记录，合同里写明「不是事故车、泡水车」；被隐瞒了可以要求退车并赔三倍车款",
          "hash": "0958395c9477",
          "mode": "L"
        },
        {
          "n": 49,
          "title": "在 4S 店买车，不交「金融服务费」，保险、贷款、上牌也不必在店里办",
          "hash": "9493379ff900",
          "mode": "L"
        },
        {
          "n": 50,
          "title": "跟团游被导游带进没约定的购物店买了东西，回来 30 天内找旅行社退货，货款让旅行社先垫",
          "hash": "e59b542c81ba",
          "mode": "L"
        },
        {
          "n": 51,
          "title": "银行员工推荐的理财，先在这家银行自己的 App 或官网里查到再买，查不到的可能是员工私卖的「飞单」",
          "hash": "9471e1fd3602",
          "mode": "L"
        }
      ],
      "file": "book/05-dung-lang-phi-tien.md"
    },
    "06": {
      "sha": "e2605d3e2242bd6216c9255192b8a8957a08c55a",
      "path": "book/06-反面清单.md",
      "header": "202992cb49bf",
      "footer": null,
      "entries": [
        {
          "n": 1,
          "title": "不要为了长寿或防心血管病吃复合维生素",
          "hash": "91d2bf7034dc",
          "mode": "T"
        },
        {
          "n": 2,
          "title": "不要为了预防心血管病吃普通鱼油",
          "hash": "91a1d59eef20",
          "mode": "T"
        },
        {
          "n": 3,
          "title": "不要为了长寿给不缺维生素 D 的人补维生素 D",
          "hash": "059cf4090ded",
          "mode": "T"
        },
        {
          "n": 4,
          "title": "不要为了防癌吃抗氧化补剂（β 胡萝卜素、维生素 E、维生素 A）",
          "hash": "489ff7b9082e",
          "mode": "T"
        },
        {
          "n": 5,
          "title": "不要指望氨糖（葡萄糖胺）/软骨素治膝关节炎",
          "hash": "9ff80f6b1f7e",
          "mode": "T"
        },
        {
          "n": 6,
          "title": "不要靠维生素 C 预防感冒",
          "hash": "535b061f4b18",
          "mode": "T"
        },
        {
          "n": 7,
          "title": "不要给没有症状的自己做「全身 PET-CT」或「肿瘤标志物套餐」",
          "hash": "62b827f8e119",
          "mode": "T"
        },
        {
          "n": 8,
          "title": "不要指望手环/手表的运动量化帮你减重",
          "hash": "f51ec54da1d3",
          "mode": "T"
        },
        {
          "n": 9,
          "title": "不要为了「更健康」花溢价买有机食品",
          "hash": "459c3ce4c037",
          "mode": "T"
        },
        {
          "n": 10,
          "title": "不要花大钱买保健品、膏方、滋补品来「调理身体」",
          "hash": "39dbf474dc94",
          "mode": "T"
        },
        {
          "n": 11,
          "title": "不要在没有肠道问题时长期吃益生菌",
          "hash": "2c55dbe2ec9d",
          "mode": "T"
        },
        {
          "n": 12,
          "title": "不要为了「增强免疫力」逼自己洗冷水澡",
          "hash": "e5922bfae295",
          "mode": "T"
        },
        {
          "n": 13,
          "title": "不要买排毒、清肠、酵素、碱性水这类产品",
          "hash": "8435f71ac424",
          "mode": "T"
        },
        {
          "n": 14,
          "title": "不要为了凑够「每天 8 杯水」强迫自己喝水",
          "hash": "510472d93af8",
          "mode": "T"
        },
        {
          "n": 15,
          "title": "不要花钱算命、看塔罗、看星座来做决定",
          "hash": "fe5e051bc5b9",
          "mode": "T"
        },
        {
          "n": 16,
          "title": "不要买防蓝光眼镜来「保护视力」，也不要相信「对着屏幕干几个月眼睛就废了」，但眼睛胀痛发红要当急症",
          "hash": "2d3da5e2a78d",
          "mode": "T"
        },
        {
          "n": 17,
          "title": "不要把献血当保健：「排毒、降血脂、防心梗」没有随机试验支持，频繁献倒是真会缺铁",
          "hash": "abc29563bda4",
          "mode": "L"
        },
        {
          "n": 18,
          "title": "不要靠通用体检套餐防病，按年龄性别做那几项有证据的筛查",
          "hash": "0a20bcdba983",
          "mode": "L"
        },
        {
          "n": 19,
          "title": "不要因为体检查出尿酸高、但从没痛过，就开始吃降尿酸药",
          "hash": "6790795e891d",
          "mode": "T"
        },
        {
          "n": 20,
          "title": "不要因为体检查出胆囊结石、但从没疼过，就去预防性切胆囊",
          "hash": "1022bddd2bb8",
          "mode": "T"
        },
        {
          "n": 21,
          "title": "不要为了防肾结石把钙戒掉",
          "hash": "0ce8e854a67a",
          "mode": "T"
        },
        {
          "n": 22,
          "title": "不要为了「转运」「招财」「养人」买水晶、手串、貔貅这类物件",
          "hash": "6a8708412e1d",
          "mode": "T"
        },
        {
          "n": 23,
          "title": "不要指望买东西改善心情或身份感",
          "hash": "f71f2c56920c",
          "mode": "T"
        },
        {
          "n": 24,
          "title": "不要为了「在周围人里往上挪一档」多花钱换房、换车、换圈子",
          "hash": "e8609b4e83b5",
          "mode": "T"
        },
        {
          "n": 25,
          "title": "不要相信「意志力像肌肉，用一会儿就没了」",
          "hash": "30ab4c795aa2",
          "mode": "T"
        },
        {
          "n": 26,
          "title": "不要指望吃早餐或 16:8 轻断食帮你控制体重，吃饭时间挑你能长期坚持的",
          "hash": "a96363d93adc",
          "mode": "T"
        },
        {
          "n": 27,
          "title": "不要相信「手淫伤身」「戒色才能变好」，真正要看的是有没有耽误睡觉、工作和关系",
          "hash": "43bb33bf8e92",
          "mode": "T"
        },
        {
          "n": 28,
          "title": "不要花钱做「性取向矫正」「同性恋治疗」，也不要把家里人送去",
          "hash": "b6df43b8a0ef",
          "mode": "L"
        },
        {
          "n": 29,
          "title": "不要指望学会「正确搬运姿势」、上搬运培训就能防腰痛，要减的是搬的重量和次数，平时多锻炼",
          "hash": "5453c4a622e3",
          "mode": "T"
        },
        {
          "n": 30,
          "title": "不要指望骨折之后猛补钙、喝骨头汤能让骨头长得更快",
          "hash": "f6382d1698e8",
          "mode": "T"
        },
        {
          "n": 31,
          "title": "不要指望靠 AI 聊天机器人自己判断病情和法律问题，看病、打官司、花大钱之前，把它说的依据找到原文核一遍",
          "hash": "e33ef7661d5e",
          "mode": "T"
        },
        {
          "n": 32,
          "title": "不要因为「人随时会死，早点把钱花完才快乐」就不存钱，三十岁的人约九成能活到六十岁",
          "hash": "36785d6f7b62",
          "mode": "L"
        },
        {
          "n": 33,
          "title": "不要因为中老年人膝盖慢慢疼起来（骨关节炎、退化性半月板撕裂）就做关节镜清理或切半月板，先减重、练大腿肌肉",
          "hash": "d790b94f0b41",
          "mode": "T"
        },
        {
          "n": 34,
          "title": "不要指望长期失眠靠吃褪黑素治好，它平均只让人早睡着约 7 分钟，先做失眠的认知行为治疗",
          "hash": "0193f92c812b",
          "mode": "T"
        },
        {
          "n": 35,
          "title": "不要因为感冒、普通发烧就要求输液，也不要在换季时去输液「冲血管」「通血管」",
          "hash": "e349ee19f31f",
          "mode": "T"
        }
      ],
      "file": "book/06-nhung-thu-tuong-dang-ma-khong-dang.md"
    },
    "08": {
      "sha": "e2605d3e2242bd6216c9255192b8a8957a08c55a",
      "path": "book/08-别把自己搭进去.md",
      "header": "cc4927e34dea",
      "footer": null,
      "entries": [
        {
          "n": 1,
          "title": "出了交通事故先停车、救人、报警，不要跑",
          "hash": "f9e44a25e216",
          "mode": "L"
        },
        {
          "n": 2,
          "title": "发现被骗，立刻打 110 或 96110 要求止付，别先自己查",
          "hash": "088bb547878f",
          "mode": "L"
        },
        {
          "n": 3,
          "title": "记住反诈硬规则：来电不轻信、信息不透露、链接不点击、转账多核实，七种最常见的骗局都是这个形状",
          "hash": "f99643345f92",
          "mode": "L"
        },
        {
          "n": 4,
          "title": "视频里看见脸、电话里听见声音都不算核实，涉及转账先挂断，用自己通讯录里的旧号码打回去",
          "hash": "d8b5d7ce2336",
          "mode": "L"
        },
        {
          "n": 5,
          "title": "被指控或被传唤，先请律师，不私了、不删记录",
          "hash": "2d1a1eaa7b72",
          "mode": "L"
        },
        {
          "n": 6,
          "title": "出了事主动去说清楚：自首最多能减四成刑，犯罪较轻的还能减更多甚至免罚，「躲过追诉期」这条路是堵死的",
          "hash": "e2124fa7279b",
          "mode": "L"
        },
        {
          "n": 7,
          "title": "喝了酒就不碰方向盘，包括电动车和「挪一下车」，也别把车借给喝了酒或没驾照的人开",
          "hash": "01515f278a5d",
          "mode": "L"
        },
        {
          "n": 8,
          "title": "不把银行卡、手机卡、支付账号借给任何人，「跑分」不是兼职",
          "hash": "fb09cf9ac152",
          "mode": "L"
        },
        {
          "n": 9,
          "title": "每年免费查两次自己的征信报告，看有没有不是自己办的贷款和卡",
          "hash": "ba37462794e5",
          "mode": "L"
        },
        {
          "n": 10,
          "title": "起了冲突先报警不动手，先动手的那个容易让对方的还手算成正当防卫",
          "hash": "a8290c3f3bf1",
          "mode": "L"
        },
        {
          "n": 11,
          "title": "躲不掉的侵害可以还手，但只打正在动手的那个人，他停你就停",
          "hash": "b7ac1befe790",
          "mode": "L"
        },
        {
          "n": 12,
          "title": "跟谁结了怨——被欠薪、被开除、被坑了钱——走投诉、仲裁、起诉，别去找人算账",
          "hash": "025b4e4e27f9",
          "mode": "L"
        },
        {
          "n": 13,
          "title": "再恨也别对不相干的人下手：驾车冲撞人群、在公共场所行凶按以危险方法危害公共安全定罪，起刑三年，死了人十年起步、最高死刑",
          "hash": "8a1d3b94c8a5",
          "mode": "L"
        },
        {
          "n": 14,
          "title": "冒出「拉个垫背的」「同归于尽」这种念头，当急症处理：离开现场，把车钥匙和刀交给别人，打 12356",
          "hash": "46a878e1e91d",
          "mode": "L"
        },
        {
          "n": 15,
          "title": "身边人说出「谁也别想好过」「带着孩子一起走」，别当气话：近亲属可以直接送诊，公安接到报警也必须管",
          "hash": "2893854d76dd",
          "mode": "L"
        },
        {
          "n": 16,
          "title": "网上不骂人、不造谣、不转发没核实的事；被网暴先留证再报警",
          "hash": "f648f56b7ed1",
          "mode": "L"
        },
        {
          "n": 17,
          "title": "签字前把纸看完，不替人签字，不在空白纸上签",
          "hash": "a0acdd79aaf7",
          "mode": "L"
        },
        {
          "n": 18,
          "title": "借钱写清借条，替人担保前先想清楚自己愿不愿意替他还",
          "hash": "3aff8a4865a5",
          "mode": "L"
        },
        {
          "n": 19,
          "title": "维权有期限：民事诉讼时效 3 年，劳动仲裁 1 年，过了对方一句「超过时效」就够",
          "hash": "6b50e486bfba",
          "mode": "L"
        },
        {
          "n": 20,
          "title": "被起诉、被执行了，如实报财产、能还多少还多少，别把房和钱转给亲友或公司",
          "hash": "c034b65fc6ef",
          "mode": "L"
        },
        {
          "n": 21,
          "title": "被限制消费或者被列入失信名单，先查清是按哪一条纳入的，能纠正的申请纠正",
          "hash": "9c6cb788f63c",
          "mode": "L"
        },
        {
          "n": 22,
          "title": "网购、二手交易被骗，先平台投诉，再报警，再算值不值得起诉",
          "hash": "2255b48c79a8",
          "mode": "L"
        },
        {
          "n": 23,
          "title": "恋爱和婚内的大额赠与，交付之前想清楚，交付之后原则上要不回",
          "hash": "ea8260b66295",
          "mode": "L"
        },
        {
          "n": 24,
          "title": "彩礼走转账并备注，聊天记录留好；借婚姻要钱可以要回",
          "hash": "88c327021ecb",
          "mode": "L"
        },
        {
          "n": 25,
          "title": "婚前财产不用怕，房子加名和父母出资先写清楚",
          "hash": "c815dd613160",
          "mode": "L"
        },
        {
          "n": 26,
          "title": "结婚前核对对方婚姻状况，以结婚为幌子骗钱的按诈骗罪追究",
          "hash": "463d50a2c179",
          "mode": "L"
        },
        {
          "n": 27,
          "title": "上门维修、验车、装修，先问价再动手，全程在旁边看着",
          "hash": "0ca042ac3f77",
          "mode": "L"
        },
        {
          "n": 28,
          "title": "别当「挂名法人」，别把身份证借给人注册公司",
          "hash": "cb85a3dc2c12",
          "mode": "L"
        },
        {
          "n": 29,
          "title": "出入境不帮陌生人带东西，不代收来路不明的包裹",
          "hash": "2fe010a08f41",
          "mode": "L"
        },
        {
          "n": 30,
          "title": "养狗必须牵绳：不牵绳出了事是无过错责任（你有没有错都要赔），赔到底。狗还要按时打狂犬病疫苗、办养犬登记",
          "hash": "36b358ba7d94",
          "mode": "L"
        },
        {
          "n": 31,
          "title": "对方喝到意识不清、睡着，或者可能不满 14 岁，就不要发生关系",
          "hash": "f890f691a13f",
          "mode": "L"
        },
        {
          "n": 32,
          "title": "发生关系、裸聊之后对方拿报警、发照片、告诉你单位来要钱，一分钱不给，一条记录不删，直接报警",
          "hash": "4a8784f93423",
          "mode": "L"
        },
        {
          "n": 33,
          "title": "被人捏造事实举报，可以要求追究：够治安处罚的拘留 5 日起，够罪的判 3 年以下",
          "hash": "0a7e34e8e1ec",
          "mode": "L"
        },
        {
          "n": 34,
          "title": "证据不足本来就应当判无罪，逼出来的口供应当排除；判了还有申诉和再审",
          "hash": "ecd878b5fbb3",
          "mode": "L"
        },
        {
          "n": 35,
          "title": "被羁押后撤案、不起诉或者判无罪的，去申请国家赔偿，按天算钱",
          "hash": "2d7c0e9d2d2a",
          "mode": "L"
        },
        {
          "n": 36,
          "title": "自己是受害人去索赔，走 12315、起诉或者律师，别单独赴对方的约，别把「给钱」和「我不曝光」绑成一句话",
          "hash": "bc6c91b60ec5",
          "mode": "L"
        },
        {
          "n": 37,
          "title": "被网暴了：先开防护、先固证，再在平台、禁令、报警三条路里挑",
          "hash": "6a017b434e4b",
          "mode": "L"
        },
        {
          "n": 38,
          "title": "「先给人买保险再动手」这条路法律上从头堵死：钱一分拿不到，罪按故意杀人加保险诈骗数罪并罚",
          "hash": "e29aa92d972b",
          "mode": "L"
        },
        {
          "n": 39,
          "title": "报警当场要受案回执，不立案要书面通知：7 日内可申请复议，再 7 日可申请复核，检察院能通知公安立案",
          "hash": "7112add8b71a",
          "mode": "L"
        },
        {
          "n": 40,
          "title": "别给办案、执法的人送钱送卡：行贿自己也判，对监察、执法、司法人员行贿还要从重",
          "hash": "61039b8f323d",
          "mode": "L"
        },
        {
          "n": 41,
          "title": "可能翻脸的电话和面谈，直接开录音：自己参加的谈话，不用先征得对方同意",
          "hash": "0a59e8a2f7a9",
          "mode": "L"
        },
        {
          "n": 42,
          "title": "现场出了事，先拍全景，再拍位置关系，最后拍损坏和伤情，原图原视频别删",
          "hash": "8c783d6de44a",
          "mode": "L"
        },
        {
          "n": 43,
